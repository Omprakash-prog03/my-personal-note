<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/canvas_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/archiveBackdrop">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/canvas_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:menu="@menu/menu_canvas"
            app:navigationIcon="@drawable/ic_back"
            app:subtitleTextColor="?attr/archiveMuted"
            app:titleTextAppearance="@style/TextAppearance.Archive.Title" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.archive.app.canvas.engine.CanvasView
                android:id="@+id/canvas_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_canvas" />

            <TextView
                android:id="@+id/canvas_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/canvas_hint"
                android:textAppearance="@style/TextAppearance.Archive.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/zoom_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_margin="12dp"
                android:background="@drawable/bg_tool_surface"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/zoom_in"
                    style="@style/Widget.Archive.IconButton"
                    android:contentDescription="@string/zoom_in"
                    android:src="@drawable/ic_zoom_in" />

                <ImageButton
                    android:id="@+id/zoom_fit"
                    style="@style/Widget.Archive.IconButton"
                    android:contentDescription="@string/zoom_fit"
                    android:src="@drawable/ic_crop" />

                <ImageButton
                    android:id="@+id/zoom_out"
                    style="@style/Widget.Archive.IconButton"
                    android:contentDescription="@string/zoom_out"
                    android:src="@drawable/ic_zoom_out" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/draw_options_card"
                style="@style/Widget.Archive.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_m">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/draw_options_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="6dp" />
                </HorizontalScrollView>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/context_card"
            style="@style/Widget.Archive.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="2dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/context_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp" />
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tool_rail_card"
            style="@style/Widget.Archive.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="@dimen/radius_l"
            app:cardElevation="3dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tool_rail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp" />
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
