<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collection_card"
    style="@style/Widget.Archive.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/cover_frame"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="?attr/colorSurfaceVariant">

            <ImageView
                android:id="@+id/cover_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_collection_cover"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/collection_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/collection_pin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:contentDescription="@string/pin"
                android:src="@drawable/ic_pin"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/collection_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Archive.Title"
                    android:textColor="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/collection_fav"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/cd_favourite"
                    android:src="@drawable/ic_heart_filled"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/collection_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Archive.Body"
                android:textColor="?attr/archiveMuted" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
