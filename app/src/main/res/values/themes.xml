<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================================================
         THEME A — WARM ARCHIVE
         ========================================================= -->
    <style name="Theme.Archive.Warm" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_ochre</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_ochre_soft</item>
        <item name="colorOnPrimaryContainer">#FF3A2A18</item>
        <item name="colorSecondary">@color/accent_ochre</item>
        <item name="colorSecondaryContainer">@color/accent_ochre_soft</item>
        <item name="colorOnSecondaryContainer">#FF3A2A18</item>
        <item name="colorSurface">@color/warm_surface</item>
        <item name="colorSurfaceVariant">@color/warm_surface_variant</item>
        <item name="colorOnSurface">@color/warm_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/warm_on_surface_variant</item>
        <item name="colorOutline">@color/warm_outline</item>
        <item name="colorControlNormal">@color/warm_on_surface_variant</item>
        <item name="android:colorBackground">@color/warm_background</item>
        <item name="colorOnBackground">@color/warm_on_surface</item>
        <item name="android:windowBackground">@color/warm_background</item>
        <item name="android:statusBarColor">@color/warm_background</item>
        <item name="android:navigationBarColor">@color/warm_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

        <item name="archiveBackdrop">@color/warm_backdrop</item>
        <item name="archiveSelection">@color/warm_selection</item>
        <item name="archiveHandleFill">@color/warm_surface</item>
        <item name="archiveMuted">@color/warm_muted</item>
        <item name="archiveRule">@color/warm_rule</item>
        <item name="archivePaper">@color/warm_paper</item>
        <item name="archivePaperInk">@color/warm_paper_ink</item>
        <item name="archiveCardTint">@color/warm_card_tint</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Archive.Display</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Archive.Headline</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Archive.Title</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Archive.Body</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Archive.Label</item>
        <item name="materialCardViewStyle">@style/Widget.Archive.Card</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Archive.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Archive.Large</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Archive.Small</item>
    </style>

