<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ Typography ============ -->
    <style name="TextAppearance.Archive.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.005</item>
    </style>

    <style name="TextAppearance.Archive.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Archive.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Archive.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Archive.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ============ Shapes ============ -->
    <style name="ShapeAppearance.Archive.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>

    <style name="ShapeAppearance.Archive.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <style name="ShapeAppearance.Archive.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>

    <!-- ============ Cards ============ -->
    <style name="Widget.Archive.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/archiveCardTint</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">1dp</item>
        <item name="cardForegroundColor">@null</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Archive.Card</item>
    </style>

    <style name="ThemeOverlay.Archive.Card" parent="">
        <item name="colorSurface">?attr/archiveCardTint</item>
    </style>

    <style name="Widget.Archive.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/archiveCardTint</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Archive.SectionLabel" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Archive.Label</item>
        <item name="android:textColor">?attr/archiveMuted</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.Archive.ToolButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconSize">@dimen/icon_m</item>
    </style>


    <style name="Widget.Archive.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Archive.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
